# Reference copy we port from; not part of this repo
/nordic-onboarding/

# Backend (Maven)
target/

# Frontend (Angular)
node_modules/
dist/
.angular/
coverage/

# Local environment and secrets
.env
.env.*
# Short-lived sign-in file the CI auth step writes into the checkout. Listed here so it is never
